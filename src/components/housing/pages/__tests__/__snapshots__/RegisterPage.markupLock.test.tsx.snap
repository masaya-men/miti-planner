ht="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">住所</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-2">自動入力でも手入力でも、登録前に必ず住所を確認します</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-3"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">3</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">コメント</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-3">タイトルは任意です。未入力の場合、一覧には住所が表示されます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-4"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">4</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">公開設定</span><span class="housing-register-s