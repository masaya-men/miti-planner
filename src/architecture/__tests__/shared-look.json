{
  "rules": [
    {
      "id": "outside-dismiss-handwritten",
      "pattern": "(document|window)\\.addEventListener\\(\\s*['\"](mousedown|pointerdown|click)['\"]",
      "files": "^src/.*\\.tsx?$",
      "sharedHome": "^src/hooks/useDismissOnOutside\\.ts$|/__tests__/|^src/components/ui/Tooltip\\.tsx$|^src/components/military/MilspecTitleTooltip\\.tsx$|^src/components/military/MilspecKey\\.tsx$",
      "why": "外側を押した時の動きは useDismissOnOutside だけが書く(外側=閉じるだけ・下に届けない)。例外 Tooltip.tsx / MilspecTitleTooltip.tsx / MilspecKey.tsx は「押したら隠す・ボタン自身の操作」で外側で閉じる物ではないため sharedHome に含める"
    }
  ],
