</div><svg class="housing-map-overlay" viewBox="0 0 1882 1394" preserveAspectRatio="xMidYMid meet" aria-hidden="true"><path class="housing-tour-target-glow" data-testid="tour-map-target-glow" d="M1417.0 311.8 L1551.4 172.6 L1559.9 172.5 L1675.6 284.3 L1675.8 292.8 L1541.4 431.9 L1532.9 432.1 L1417.1 320.3 L1417.0 311.8 Z"></path><path class="housing-tour-route-glow" d="M1244.5 300.6 L1244.5 351.5 L1339.0 351.5 L1407.2 429.5 L1470.5 374.3" fill="none"></path><path data-testid="tour-map-route" class="housing-tour-route-core" d="M1244.5 300.6 L1244.5 351.5 L1339.0 351.5 L1407.2 429.5 L1470.5 374.3" fill="none"><animate attributeName="stroke-dashoffset" from="0" to="-64" dur="1.1s" repeatCount="indefinite"></animate></path><circle class="housing-tour-route-comet" r="10"><animateMotion dur="2.2s" repeatCount="indefinite" path="M1244.5 300.6 L1244.5 351.5 L1339.0 351.5 L1407.2 429.5 L1470.5 374.3" rotate="auto"></animateMotion></circle><g data-testid="tour-map-origin" class="housing-tour-map-origin-mark"><circle class="housing-tour-map-origin-pulse" cx="1244.4913199999999" cy="300.6161" r="14"><animate attributeName="r" from="14" to="30" dur="1.6s" repeatCount="indefinite"></animate><animate attributeName="opacity" from="0.9" to="0" dur="1.6s" repeatCount="indefinite"></animate></circle><circle class="housing-tour-map-origin-core" cx="1244.4913199999999" cy="300.6161" r="7"></circle></g></svg></div></div><div class="housing-hud is-top"><button type="button" data-testid="tour-map-reset" class="housing-tour-map-reset">デフォルト表示に戻す</button></div><div class="housing-tour-map-compass" data-testid="tour-map-compass" aria-hidden="true"><svg viewBox="0 0 40 40"><circle class="housing-tour-map-compass-ring" cx="20" cy="21" r="16"></circle><path class="housing-tour-map-compass-needle-n" d="M20 8 L24.5 22 L20 19 L15.5 22 Z"></path><path class="housing-tour-map-compass-needle-s" d="M20 34 L15.5 22 L20 25 L24.5 22 Z"></path><text class="housing-tour-map-compass-n" x="20" y="7">N</text></svg></div><div class="housing-tour-map-hint" data-testid="tour-map-hint" aria-hidden="true">ホイールでズーム・ドラッグで移動</div></div></div></div><div class="housing-register-guide" data-testid="housing-register-guide"><h2 class="housing-register-guide-title">登録の流れ</h2><ol class="housing-register-guide-steps"><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">1</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">画像・SNS URL を貼る</span><span class="housing-register-guide-step-desc">Twitter / YouTube の URL を貼ると、 住所や画像を自動で読み取ります</span></div></li><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">2</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">住所・コメントを入力する</span><span class="housing-register-guide-step-desc">自動入力された内容を確認し、 タイトルやタグを添えます</span></div></li><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">3</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">公開設定を選んで登録する</span><span class="housing-register-guide-step-desc">公開または非公開を選び、 内容を確認して登録します</span></div></li></ol></div></div></section></div></div>",
  "label": "tweet-duplicate-url",
}
`;

exports[`RegisterPage markupLock (分割前の記録) > 一時ツアーのプリフィル 1`] = `
