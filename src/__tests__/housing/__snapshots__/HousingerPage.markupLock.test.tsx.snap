exports[`HousingerPage 分割前後の HTML 固定 > 本人視点: 公開切替の確認窓 1`] = `"<div><div class="housing-detail-panel"><div class="housing-detail-shell"><header class="housing-detail-fullpage-header housinger-page-headerbar"><a class="housing-detail-back" aria-label="戻る" href="/housing" data-discover="true">← 戻る</a></header><main class="housing-detail-fullpage-main housinger-page-main"><div class="housinger-page-body"><div class="housinger-page-profile-col"><div class="housinger-page-identity"><div class="housinger-page-avatar-wrap"><span class="housinger-avatar housinger-page-avatar"><span class="housinger-avatar-fallback" aria-hidden="true">た</span></span><button type="button" class="housinger-page-avatar-edit-btn" aria-label="アバターを変更" title="アバターを変更"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg></button></div><h2 class="housinger-page-name">たかし</h2><button type="button" class="housinger-page-edit-btn" aria-label="プロフィールを編集" title="プロフィールを編集"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg></button></div><div class="housing-account-housinger"><div class="housing-account-housinger-titlerow"><h4 class="housing-account-housinger-title">ハウジンガー公開</h4><div class="housing-share"><button type="button" class="housing-action-btn" aria-label="シェア" aria-haspopup="menu" aria-expanded="false">シェア</button><button type="button" class="housing-action-btn is-icon" aria-label="Xでシェア" title="Xでシェア"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class=""><g class="x-icon" style="transform-origin: center;"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></g></svg></button></div></div><p class="housing-account-housinger-desc">あなたの名前・アイコン・ひとことをまとめた公開ページができ、登録したハウジングと一緒にみんなに見てもらえます</p><p class="housing-account-name-note">この名前がハウジンガータグとして使われます</p></div></div><div class="housinger-page-listings-col"><div class="housing-listing-grid-wrap"><div class="housing-listing-grid-toolbar"><div class="housing-listing-grid-toolbar-start"><h2 class="housing-listing-grid-heading">ハウジング一覧<span class="housing-listing-grid-count">1件</span><span class="housing-listing-grid-og-hint">カード左上のチェックで、シェア時の画像に使う代表作(最大10件)を選べます。選んだカードに出るアイコンをタップすると、その1枚を背景にも使えます</span></h2></div><div class="housing-listing-grid-toolbar-actions"><div class="housing-sort" data-open="false"><span class="housing-sort-label">並び替え</span><button type="button" class="housing-sort-trigger" aria-expanded="false"><span>新着順</span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down housing-sort-chevron" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div></div><div class="housing-listing-grid"><article class="housing-listing-card" style="content-visibility: auto;" data-testid="housing-listing-card" role="link" tabindex="0" aria-label="ミスト・ヴィレッジ 1-3"><div class="housing-listing-card-media"><img alt="" loading="lazy" decoding="async" class="housing-listing-card-img" src="/housing/mock-thumbs/1.svg"><div class="housing-listing-card-topleft"><button type="button" class="housing-card-select is-selected" aria-label="選択" aria-pressed="true" data-testid="housing-card-select"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></button><button type="button" class="housing-card-background-select" aria-label="背景にも使う" aria-pressed="false" data-testid="housing-card-background-select"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></button></div><button type="button" class="housing-card-visibility-badge housing-card-visibility-badge-overlay" aria-haspopup="menu" aria-expanded="false">公開</button><button type="button" class="housing-card-edit-btn housing-card-edit-btn-overlay" aria-label="編集" title="編集"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg></button><div class="housing-listing-card-caption" aria-hidden="true"><div class="housing-marquee-clip"><div class="housing-marquee-track"><div class="housing-marquee-copy"><span>ミスト・ヴィレッジ 1-3</span></div></div></div></div></div></article></div></div></div></div></main></div><div class="housing-modal-backdrop"><div role="dialog" aria-modal="true" class="housing-delete-confirm-card"><h2 class="housing-delete-confirm-title">公開状態を変更しますか?</h2><p class="housing-delete-confirm-target">「」→ 住所非公開</p><div class="housing-delete-confirm-actions"><button type="button">キャンセル</button><button type="button">変更する</button></div></div></div></div></div>"`;

exports[`HousingerPage 分割前後の HTML 固定 > 非公開・存在しない 1`] = `"<div><div class="housing-detail-panel"><div class="housing-detail-shell"><main class="housing-detail-fullpage-main"><p>このハウジンガーは公開されていません</p><a class="housing-detail-back" aria-label="戻る" href="/housing" data-discover="true">← 戻る</a></main></div></div></div>"`;
