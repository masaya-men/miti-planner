// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProgressTrackingHUD DOM 不変 > クリア済み 1`] = `"<div data-progress-hud-band="true" class="group w-full cursor-pointer"><div class="flex items-center gap-4"><div class="shrink-0 leading-tight"><div class="text-app-sm font-bold text-app-text whitespace-nowrap">1progress.active_days_unit 0progress.active_hours_unit</div><div class="text-app-md font-bold text-app-blue" style="text-shadow: 0 0 8px var(--app-blue);">progress.cleared</div></div><div class="relative flex-1 h-11 overflow-visible"><canvas class="absolute inset-0 w-full h-full pointer-events-none"></canvas><i data-testid="toast"></i></div></div></div><i data-testid="panel"></i><i data-testid="celebration"></i>"`;

exports[`ProgressTrackingHUD DOM 不変 > 空状態 1`] = `"<div data-progress-hud-band="true" class="group w-full cursor-pointer"><div class="flex items-center justify-center h-9 min-w-0"><span title="progress.empty_cta" class="whitespace-nowrap truncate text-app-sm text-app-text-sec group-hover:text-app-text underline-offset-4 group-hover:underline transition-all duration-200">progress.empty_cta</span></div></div><i data-testid="panel"></i>"`;

exports[`ProgressTrackingHUD DOM 不変 > 軌跡あり + 活動日数・時間 1`] = `"<div data-progress-hud-band="true" class="group w-full cursor-pointer"><div class="flex items-center gap-4"><div class="shrink-0 leading-tight"><div class="text-app-sm font-bold text-app-text whitespace-nowrap">5progress.active_days_unit 12progress.active_hours_unit</div><div class="text-app-md font-bold whitespace-nowrap">progress.progress_label 75<span class="text-app-2xs text-app-text-muted">%</span></div></div><div class="relative flex-1 h-11 overflow-visible"><canvas class="absolute inset-0 w-full h-full pointer-events-none"></canvas><i data-testid="toast"></i></div></div></div><i data-testid="panel"></i>"`;

exports[`ProgressTrackingHUD DOM 不変 > 軌跡あり・活動日数なし 1`] = `"<div data-progress-hud-band="true" class="group w-full cursor-pointer"><div class="flex items-center gap-4"><div class="shrink-0 leading-tight"><div class="text-app-md font-bold whitespace-nowrap">progress.progress_label 50<span class="text-app-2xs text-app-text-muted">%</span></div></div><div class="relative flex-1 h-11 overflow-visible"><canvas class="absolute inset-0 w-full h-full pointer-events-none"></canvas><i data-testid="toast"></i></div></div></div><i data-testid="panel"></i>"`;
