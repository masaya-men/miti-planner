{
  "maxLines": 500,
  "ignore": [
    {
      "pattern": "^src/locales/",
      "reason": "翻訳データ(5 言語の文言の一覧)。1 キー 1 行のデータで、分けると言語間の突き合わせが難しくなる"
    },
    {
      "pattern": "^src/data/templates/",
      "reason": "コンテンツごとのタイムラインのデータ(攻撃の一覧)。1 コンテンツ 1 ファイルのデータで、プログラムではない"
    },
    {
      "pattern": ".generated.",
      "reason": "自動生成ファイル(人は編集しない・生成元を直す)"
    },
    {
      "pattern": "^docs/housing-maps-src/.*.svg$",
      "reason": "ハウジング地図の元絵(書き出した SVG データ・エーテライト座標の正典)。プログラムではない"
    },
    {
      "pattern": "^scripts/milspec-sp2/.baseline/",
      "reason": "検査道具が自動で書き出した計測の基準値(データ)"
    },
    {
      "pattern": "^src/data/contents.json$",
      "reason": "コンテンツのマスターデータ(1 コンテンツ 1 項目の一覧)。プログラムではない"
    },
    {
      "pattern": "^scripts/visual-regress/fixtures/",
      "reason": "見た目比較の固定データ(サーバー応答の写し)。プログラムではない"
    }
  ],
  "frozen": {
    "api/admin/_templatesHandler.ts": 521,
    "api/og/_housingerCard.ts": 518,
    "public/ogp-preview.html": 509,
    "src/__tests__/housing/HousingerPage.test.tsx": 665,
