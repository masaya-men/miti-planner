t-bold">ナイト</span></div></th><th class="sticky top-0 bg-app-surface2 border-b border-r border-app-border px-3 py-2 text-left"><div class="flex flex-col gap-1 min-w-[90px]"><span class="font-bold">白魔道士</span></div></th><th class="sticky top-0 bg-app-surface2 border-b border-r border-app-border px-3 py-2 text-left"><div class="flex flex-col gap-1 min-w-[90px]"><span class="font-bold">忍者</span></div></th></tr></thead><tbody><tr><td class="border-b border-r border-app-border px-3 py-1.5 text-app-text"></td><td class="border-b border-r border-app-border px-3 py-1.5 text-app-text">開幕</td><td class="border-b border-r border-app-border px-3 py-1.5 text-app-text">0:16</td><td class="border-b border-r border-app-border px-3 py-1.5 text-app-text">ビッグブラスト</td><td class="border-b border-r border-app-border px-3 py-1.5 text-app-text">100,000</td><td class="border-b border-r border-app-border px-2 py-1"><select aria-label="攻撃の対象を選択" class="w-full appearance-none rounded border px-1 py-0.5 text-app-sm focus:outline-none focus:border-app-text bg-app-surface2 border-app-border text-app-text"><option value="MT">MT</option><option value="ST">ST</option><option value="AoE">全体</option><option value="none">—</option></select></td><td class="border-b border-r border-app-border px-3 py-1.5 text-app-text">魔法</td><td class="border-b border-r border-app-border px-3 py-1.5"><span><span class="text-app-text">ランパート</span></span></td><td class="border-b border-r border-app-border px-3 py-1.5"><span><span class="text-app-text">アサイラム</span></span></td><td class="border-b border-r border-app-border px-3 py-1.5"><span><span class="text-app-amber underline decoration-dotted">かげぬい</span></span></td></tr></tbody></table></div></div><div class="px-5 py-3 border-t border-app-border flex flex-col gap-1.5 shrink-0"><div class="flex items-center justify-between gap-3"><div class="flex items-center gap-2"><button type="button" class="inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-md border