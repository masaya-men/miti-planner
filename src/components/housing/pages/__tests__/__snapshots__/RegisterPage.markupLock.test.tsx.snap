x="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle></svg><ol class="housing-register-stepper-list"><li><button type="button" class="housing-register-stepper-item is-active" data-testid="housing-register-step-1" aria-current="step"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">1</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">SNS投稿・サイトから自動入力</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-1">住所が書いてあるSNS投稿やサイトのURLを貼ると、写真と住所の自動入力を試みます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-2"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">2</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">住所</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-2">自動入力でも手入力でも、登録前に必ず住所を確認します</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-3"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">3</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">コメント</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-3">タイトルは任意です。未入力の場合、一覧には住所が表示されます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-4"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">4</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">公開設定</span><span class="housing-register-s