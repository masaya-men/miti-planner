  "label": "dup-private-found",
}
`;

exports[`RegisterPage markupLock (分割前の記録) > 住所確認 → 画像1枚 → 送信(重複なし→登録→遷移) 1`] = `
{
  "calls": [
    [
      "localStorage.removeItem",
      "housing-register-draft",
    ],
