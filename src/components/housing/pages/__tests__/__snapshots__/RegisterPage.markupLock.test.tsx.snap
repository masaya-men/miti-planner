      "{"title":"新しい家","description":"","tags":[],"dc":"Meteor","server":"Ramuh","area":"LavenderBeds","ward":29,"buildingType":"house","plot":3,"size":"L","visibility":"public","publishUntil":null,"afterExpiryVisibility":"unlisted"}",
    ],
  ],
  "html": "<div><div class="housing-register" data-testid="housing-register-form-root"><section class="housing-register-panel" data-region="left"><div class="housing-register-col housing-register-col-left"><div class="housing-register-left-scroll"><nav class="housing-register-stepper" aria-label="登録ステップ"><div class="housing-register-stepper-viewport" data-overflow="false"><div class="housing-register-stepper-body" style="transform: translateY(0px);"><svg class="housing-register-stepper-svg" data-testid="housing-register-stepper-svg" width="100%" height="0" aria-hidden="true"><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle><circle class="housing-register-stepper-ring" cx="21" cy="0" r="10" style="stroke-dasharray: 62.83185307179586; stroke-dashoffset: 62.83185307179586;"></circle></svg><ol class="housing-register-stepper-list"><li><button type="button" class="housing-register-stepper-item is-active" data-testid="housing-register-step-1" aria-current="step"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">1</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">SNS投稿・サイトから自動入力</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-1">住所が書いてあるSNS投稿やサイトのURLを貼ると、写真と住所の自動入力を試みます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-done" data-testid="housing-register-step-2"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">2</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">住所</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-2">自動入力でも手入力でも、登録前に必ず住所を確認します</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-done" data-testid="housing-register-step-3"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">3</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">コメント</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-3">タイトルは任意です。未入力の場合、一覧には住所が表示されます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-4"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">4</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">公開設定</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-4">公開・非公開と、公開期限を選べます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-done" data-testid="housing-register-step-5"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">5</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">確認</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-5">入力内容をまとめて確認し、登録します</span></span></span></span></button></li></ol></div></div></nav></div><p class="housing-register-left-remaining" data-testid="housing-register-guide-remaining">本日の登録枠: 残り 3 / 5 件</p></div></section><section class="housing-register-panel" data-region="center"><div class="housing-register-col housing-register-col-center"><div class="housing-register-sections"><div data-step-id="media"><section class="housing-register-section" data-testid="housing-register-section-media"><h2 class="housing-register-section-title">SNS投稿・サイトから自動入力</h2><p class="housing-register-image-limit-note">画像は最大10枚まで、動画は最大1本まで登録できます。</p><div class="housing-register-multi-url-field"><div class="housing-register-multi-url-row"><div class="housing-register-sns-url-field"><label for="housing-sns-url" class="housing-label">投稿・サイトのURL（任意）</label><input id="housing-sns-url" class="housing-input" autocomplete="off" placeholder="URLを貼ってください" type="url" value=""><p class="housing-register-sns-url-help">X(旧Twitter)・YouTube・ハウジングスナップなどに対応。動画付きの投稿もOKです</p><p class="housing-register-sns-url-help housing-register-sns-url-help-disclaimer">自動入力は正確でない場合があります。あくまで入力の補助としてご利用ください。</p></div></div><button type="button" class="housing-register-multi-url-add" data-testid="housing-multi-url-add">＋ URLを追加</button></div><div data-testid="housing-register-image-field"><p class="housing-register-upload-warning">アップロードすると画質が圧縮されて劣化します。動画は使用できません。URLでの登録をおすすめします。</p><div class="housing-register-image-field"><label class="housing-register-image-label">画像 (任意・最大 4 枚)</label><ul class="housing-register-image-grid"><li style="opacity: 1; cursor: grab; transition: transform 0ms linear;" class="housing-register-image-tile" data-dragging="false" role="button" tabindex="0" aria-disabled="false" aria-roledescription="sortable" aria-describedby="DndDescribedBy-0"><img alt="" draggable="false" loading="lazy" decoding="async" class="housing-register-image-tile-img" src="blob:mock/0"><span class="housing-register-image-tile-badge">カバー</span><button type="button" class="housing-register-image-tile-remove" aria-label="削除">✕</button><span class="housing-register-image-tile-meta">800B (WEBP)</span></li></ul><div id="DndDescribedBy-0" style="display: none;">
    To pick up a draggable item, press the space bar.
    While dragging, use the arrow keys to move the item.
    Press space again to drop the item in its new position, or press escape to cancel.
  </div><div id="DndLiveRegion-0" style="position: fixed; top: 0px; left: 0px; width: 1px; height: 1px; margin: -1px; border: 0px; padding: 0px; overflow: hidden; clip-path: inset(100%); white-space: nowrap;" role="status" aria-live="assertive" aria-atomic="true"></div><div class="housing-register-image-dropzone" role="button" tabindex="0" aria-label="画像ファイルを選択"><input accept="image/*" multiple="" class="housing-register-image-input" tabindex="-1" type="file"><span class="housing-register-image-cta">+ 画像を追加</span><span class="housing-register-image-hint">1 / 4 枚・長辺 1920px・1 枚あたり最大 1MB に自動圧縮 (AVIF/WebP)。 ドラッグで並び替えできます (先頭が代表画像になります)</span></div></div></div></section></div><div data-step-id="address"><section class="housing-register-section" data-testid="housing-register-section-address"><h2 class="housing-register-section-title">住所</h2><p class="housing-address-note" data-testid="housing-register-address-verify-note">自動入力された住所も、登録前に必ず確認してください</p><div class="housing-register-fields-grid"><div class="housing-field" data-state="confirmed"><label for="housing-register-dc" class="housing-label">データセンター</label><select id="housing-register-dc" class="housing-input"><option value="">—</option><option value="Elemental">Elemental</option><option value="Gaia">Gaia</option><option value="Mana">Mana</option><option value="Meteor">Meteor</option><option value="Aether">Aether</option><option value="Primal">Primal</option><option value="Crystal">Crystal</option><option value="Dynamis">Dynamis</option><option value="Chaos">Chaos</option><option value="Light">Light</option><option value="Shadow">Shadow</option><option value="Materia">Materia</option><option value="Korea">韓国DC</option><option value="ChocoboCN">チョコボ (中国)</option><option value="MoogleCN">モーグリ (中国)</option><option value="FatCatCN">デブチョコボ (中国)</option><option value="MameshibaCN">マメシバ (中国)</option><option value="TW">TW</option></select></div><div class="housing-field" data-state="confirmed"><label for="housing-register-server" class="housing-label">サーバー</label><select id="housing-register-server" class="housing-input"><option value="">—</option><option value="Belias">Belias</option><option value="Mandragora">Mandragora</option><option value="Ramuh">Ramuh</option><option value="Shinryu">Shinryu</option><option value="Unicorn">Unicorn</option><option value="Valefor">Valefor</option><option value="Yojimbo">Yojimbo</option><option value="Zeromus">Zeromus</option></select></div><div class="housing-field" data-state="confirmed"><label for="housing-register-area" class="housing-label">エリア</label><select id="housing-register-area" class="housing-input"><option value="">—</option><option value="Mist">ミスト・ヴィレッジ</option><option value="LavenderBeds">ラベンダーベッド</option><option value="Goblet">ゴブレットビュート</option><option value="Shirogane">シロガネ</option><option value="Empyreum">エンピレアム</option></select></div><div class="housing-field" data-state="confirmed"><label for="housing-register-ward" class="housing-label">区</label><div class="housing-stepper"><input id="housing-register-ward" inputmode="numeric" class="housing-input housing-stepper-input" min="1" max="30" type="number" value="29"><span class="housing-stepper-btns" aria-hidden="true"><button type="button" class="housing-stepper-btn housing-stepper-up" data-testid="housing-register-ward-up" tabindex="-1">▲</button><button type="button" class="housing-stepper-btn housing-stepper-down" data-testid="housing-register-ward-down" tabindex="-1">▼</button></span></div></div><div class="housing-field housing-field-full" data-state="confirmed"><label class="housing-label">建物タイプ</label><div class="housing-type-selector" role="radiogroup"><button type="button" class="housing-type-chip" data-selected="true" role="radio" aria-checked="true">個人宅・FCハウス</button><button type="button" class="housing-type-chip" data-selected="false" role="radio" aria-checked="false">アパルトメント</button></div></div><div class="housing-field housing-conditional-field" data-state="confirmed"><label for="housing-register-plot" class="housing-label">番地</label><div class="housing-stepper"><input id="housing-register-plot" inputmode="numeric" class="housing-input housing-stepper-input" min="1" max="60" type="number" value="3"><span class="housing-stepper-btns" aria-hidden="true"><button type="button" class="housing-stepper-btn housing-stepper-up" data-testid="housing-register-plot-up" tabindex="-1">▲</button><button type="button" class="housing-stepper-btn housing-stepper-down" data-testid="housing-register-plot-down" tabindex="-1">▼</button></span></div></div><div class="housing-field housing-conditional-field" data-state="confirmed"><label for="housing-register-size" class="housing-label">サイズ</label><input id="housing-register-size" class="housing-input" disabled="" readonly="" type="text" value="Lハウス"></div><div class="housing-field housing-field-full housing-conditional-field" data-state="edited"><label class="housing-register-room-toggle"><input data-testid="housing-register-room-chamber-toggle" type="checkbox"><span class="housing-register-room-toggle-track" aria-hidden="true"><span class="housing-register-room-toggle-knob"></span></span><span>FCハウスの個室です</span></label></div></div></section></div><div data-step-id="intro"><section class="housing-register-section" data-testid="housing-register-section-intro"><h2 class="housing-register-section-title">コメント</h2><div class="housing-field"><label for="housing-register-title" class="housing-label">タイトル</label><input id="housing-register-title" data-testid="housing-register-title-input" class="housing-input" maxlength="50" placeholder="タイトルを入力" type="text" value="新しい家"><p class="housing-address-note" data-testid="housing-register-title-remaining">残り 46 文字</p></div><div class="housing-field"><label for="housing-desc" class="housing-label">コメント (任意・200文字まで)</label><textarea id="housing-desc" rows="4" maxlength="250" class="housing-textarea" placeholder="自由に書いてください"></textarea><p class="housing-address-note">200</p></div><div class="housing-tag-picker"><div class="housing-tag-picker-selected" aria-label="選択中"><span class="housing-tag-picker-counter">テーマを 5 件まで選べます</span></div><input placeholder="タグを検索…" class="housing-input housing-tag-picker-search" type="search" value=""><div class="housing-tag-picker-tabs" role="tablist"><button role="tab" type="button" aria-selected="true" class="housing-tag-picker-tab">公式</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">季節</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">テーマ</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">初心者</button></div><div class="housing-tag-picker-list"><button type="button" aria-pressed="false" class="housing-tag-picker-option">ショップ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">マネキンショップ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">こだわりの内装</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">交流帳</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">酒場</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">レストラン</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">訪問歓迎</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">内装準備中</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">ロールプレイ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">水族館</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">聖堂</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">喫茶店</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">花屋</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">図