tns" aria-hidden="true"><button type="button" class="housing-stepper-btn housing-stepper-up" data-testid="housing-register-plot-up" tabindex="-1">▲</button><button type="button" class="housing-stepper-btn housing-stepper-down" data-testid="housing-register-plot-down" tabindex="-1">▼</button></span></div></div><div class="housing-field housing-conditional-field" data-state="auto-filled"><label for="housing-register-size" class="housing-label">サイズ</label><input id="housing-register-size" class="housing-input" disabled="" readonly="" type="text" value="Lハウス"><span class="housing-field-badge" data-testid="housing-auto-badge-size" aria-hidden="true">🟡</span></div><div class="housing-field housing-field-full housing-conditional-field" data-state="edited"><label class="housing-register-room-toggle"><input data-testid="housing-register-room-chamber-toggle" type="checkbox"><span class="housing-register-room-toggle-track" aria-hidden="true"><span class="housing-register-room-toggle-knob"></span></span><span>FCハウスの個室です</span></label></div></div></section></div><div data-step-id="intro"><section class="housing-register-section" data-testid="housing-register-section-intro"><h2 class="housing-register-section-title">コメント</h2><div class="housing-field"><label for="housing-register-title" class="housing-label">タイトル</label><input id="housing-register-title" data-testid="housing-register-title-input" class="housing-input" maxlength="50" placeholder="タイトルを入力" type="text" value=""><p class="housing-address-note" data-testid="housing-register-title-remaining">残り 50 文字</p><p class="housing-address-note" data-testid="housing-register-title-optional-hint">未入力の場合、住所が表示されます</p></div><div class="housing-field"><label for="housing-desc" class="housing-label">コメント (任意・200文字まで)</label><textarea id="housing-desc" rows="4" maxlength="250" class="housing-textarea" placeholder="自由に書いてください"></textarea><p class="housing-address-note">200</p></div><div class="housing-tag-picker"><div class="housing-tag-picker-selected" aria-label="選択中"><span class="housing-tag-picker-counter">テーマを 5 件まで選べます</span></div><input placeholder="タグを検索…" class="housing-input housing-tag-picker-search" type="search" value=""><div class="housing-tag-picker-tabs" role="tablist"><button role="tab" type="button" aria-selected="true" class="housing-tag-picker-tab">公式</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">季節</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">テーマ</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">初心者</button></div><div class="housing-tag-picker-list"><button type="button" aria-pressed="false" class="housing-tag-picker-option">ショップ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">マネキンショップ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">こだわりの内装</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">交流帳</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">酒場</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">レストラン</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">訪問歓迎</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">内装準備中</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">ロールプレイ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">水族館</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">聖堂</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">喫茶店</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">花屋</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">図書館</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">アトリエ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">銭湯</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">植物園</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">パン屋</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">音楽堂</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">イベント</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">撮影スタジオ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">ホラーハウス</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">東方様式</button></div></div></section></div><div data-step-id="visibility"><section class="housing-register-section" data-testid="housing-register-section-visibility"><h2 class="housing-register-section-title">公開設定</h2><div class="housing-field housing-field-full"><div class="housing-type-selector" role="radiogroup" aria-label="公開範囲"><button type="button" class="housing-register-visibility-chip" data-testid="housing-register-visibility-public" data-selected="true" role="radio" aria-checked="true"><span class="housing-register-visibility-chip-title">公開</span><span class="housing-register-visibility-chip-desc">探す・地図・ツアーに表示され、住所も見えます</span></button><button type="button" class="housing-register-visibility-chip" data-testid="housing-register-visibility-unlisted" data-selected="false" role="radio" aria-checked="false"><span class="housing-register-visibility-chip-title">住所非公開</span><span class="housing-register-visibility-chip-desc">画像は探すに出ますが、住所は隠れ、ツアーには使えません</span></button><button type="button" class="housing-register-visibility-chip" data-testid="housing-register-visibility-private" data-selected="false" role="radio" aria-checked="false"><span class="housing-register-visibility-chip-title">非公開</span><span class="housing-register-visibility-chip-desc">自分だけが見られます</span></button></div></div><div class="housing-register-promo" data-testid="housing-register-promo"><label class="housing-register-promo-toggle"><input data-testid="housing-register-promo-toggle" type="checkbox" checked=""><span class="housing-register-promo-toggle-track" aria-hidden="true"><span class="housing-register-promo-toggle-knob"></span></span><span>LoPo 運営による X（Twitter）での紹介を許可する</span></label><p class="housing-register-promo-note">オンのとき、登録後に LoPo 運営が X でこのハウジングを紹介することがあります。オフにしても公開範囲や表示は変わりません。</p></div><div class="housing-register-visibility-enddate"><label class="housing-register-visibility-enddate-toggle"><input data-testid="housing-register-visibility-enddate-toggle" type="checkbox"><span class="housing-register-visibility-enddate-toggle-track" aria-hidden="true"><span class="housing-register-visibility-enddate-toggle-knob"></span></span><span>公開終了日時を設定する</span></label></div><p class="housing-register-visibility-note">公開終了日時を過ぎると、 選んだ設定に自動的に切り替わります</p></section></div><div data-step-id="confirm"><section class="housing-register-section" data-testid="housing-register-section-confirm"><h2 class="housing-register-section-title">確認</h2><div class="housing-register-confirm-address" data-testid="housing-register-confirm-address-gate"><div class="housing-register-confirm-address-line"><span class="housing-register-confirm-address-label">住所</span><span class="housing-register-confirm-address-value">日本 / Meteor / Ramuh / ラベンダーベッド 29-3</span></div><p class="housing-register-confirm-gate-lead">住所を確認して、下のボタンを押してください</p><button type="button" class="housing-register-confirm-gate-btn" data-testid="housing-register-confirm-address-btn" data-confirmed="false" data-address-missing="false">この住所で間違いありません</button></div><dl class="housing-register-confirm-summary"><div class="housing-register-confirm-summary-row"><dt>タイトル</dt><dd><span class="housing-register-confirm-summary-empty">未入力</span></dd></div><div class="housing-register-confirm-summary-row"><dt>SNS投稿・サイトから自動入力</dt><dd>0 枚</dd></div><div class="housing-register-confirm-summary-row"><dt>公開設定</dt><dd>公開</dd></div></dl><div class="housing-register-confirm-missing"><p class="housing-register-confirm-missing-lead">登録するには、 以下を入力してください</p><ul class="housing-register-confirm-missing-list"><li data-testid="housing-register-confirm-missing-address">住所を確認してください</li><li data-testid="housing-register-confirm-missing-image">画像または動画を追加してください</li></ul></div><button type="button" class="housing-action-btn housing-btn-primary housing-register-confirm-submit" data-testid="housing-register-confirm-submit" disabled="">公開する</button></section></div></div></div></section><section class="housing-register-panel" data-region="right"><div class="housing-register-col housing-register-col-right"><div class="housing-register-check-panel" data-testid="housing-register-check-panel"><h2 class="housing-register-check-panel-title">登録前に確認</h2><ul class="housing-register-check-list"><li class="housing-register-check-row is-todo" data-testid="housing-register-check-address"><span class="housing-register-check-icon" aria-hidden="true">⚠</span><span class="housing-register-check-label">住所</span></li><li class="housing-register-check-row is-todo" data-testid="housing-register-check-title"><span class="housing-register-check-icon" aria-hidden="true">⚠</span><span class="housing-register-check-label">タイトル (任意)</span></li><li class="housing-register-check-row is-todo" data-testid="housing-register-check-image"><span class="housing-register-check-icon" aria-hidden="true">⚠</span><span class="housing-register-check-label">画像・動画 (必須)</span></li></ul></div><div class="housing-register-dup-panel" data-state="clear" data-testid="housing-register-dup-panel"><h2 class="housing-register-dup-panel-title">重複チェック</h2><p class="housing-register-dup-quiet-text" data-testid="housing-register-dup-clear">同じ住所のハウジングは見つかりませんでした</p></div><div class="housing-register-map-preview" data-testid="housing-register-map-preview"