{
  "rules": [
    {
      "id": "outside-dismiss-handwritten",
      "pattern": "(document|window)\\.addEventListener\\(\\s*['\"](mousedown|pointerdown|click)['\"]",
      "files": "^src/.*\\.tsx?$",
      "sharedHome": "^src/hooks/useDismissOnOutside\\.ts$|/__tests__/|^src/components/ui/Tooltip\\.tsx$|^src/components/military/MilspecTitleTooltip\\.tsx$|^src/components/military/MilspecKey\\.tsx$|^src/components/progress/ProgressRecordPanel\\.tsx$|^src/components/timeline/useTimelineWindowEvents\\.ts$",
      "why": "外側を押した時の動きは useDismissOnOutside だけが書く(外側=閉じるだけ・下に届けない)。例外 Tooltip.tsx / MilspecTitleTooltip.tsx / MilspecKey.tsx は「押したら隠す・ボタン自身の操作」で外側で閉じる物ではないため sharedHome に含める。ProgressRecordPanel.tsx の記録モード中だけは、外側(タイムラインのマス)を押した click が「記録を確定する」本来の操作なので、click を止める共通フックに乗せられず手書きのまま残す(記録モードでない時の外側押下はフックに乗せ替え済み)。useTimelineWindowEvents.ts の全消去メニューは「どこを押しても(内側でも)閉じる」物で外側検知ではない"
    },
    {
      "id": "menu-radius-handwritten",
      "pattern": "(?<!(?:\\/\\/|\\n\\s*\\*)[^\\n]*)rounded-\\[10px\\]",
      "files": "^src/(?!components/housing/|styles/housing|components/admin/).*\\.tsx$",
      "sharedHome": "^$|/__tests__/",
      "why": "メニュー・ポップオーバーの角は共通のトークン/部品が書く(今は共通の置き場が無く全部が手書き)。Task 13 で共通のトークン/部品へ寄せる。増やさず、減らすだけ"
    },
    {
      "id": "sheet-radius-handwritten",
      "pattern": "(?<!(?:\\/\\/|\\n\\s*\\*)[^\\n]*)rounded-t-(2xl|3xl|\\[[0-9.]+(px|rem)\\])",
      "files": "^src/(?!components/housing/|styles/housing|components/admin/).*\\.tsx$",
      "sharedHome": "^src/components/MobileBottomSheet\\.tsx$|/__tests__/",
      "why": "ボトムシートの角は MobileBottomSheet / MOBILE_TOKENS.sheet.radius が書く(rounded-t-2xl や max-md:rounded-t-2xl も同じ意味の手書き)。Task 13 で MobileBottomSheet か共通のトークンへ寄せる"
    },
    {
      "id": "primary-button-handwritten",
      "pattern": "(?<!(?:\\/\\/|\\n\\s*\\*)[^\\n]*)hover:bg-app-blue-hover",
      "files": "^src/(?!components/housing/|styles/housing|components/admin/).*\\.tsx$",
      "sharedHome": "^src/components/ui/ModalParts\\.tsx$|/__tests__/",
      "why": "青い決定ボタンは ModalButton(ui/ModalParts.tsx)が書く。手書きの bg-app-blue + hover:bg-app-blue-hover を増やさない。Task 13 で ModalButton(size=lg 追加)へ寄せる"
    },
    {
      "id": "mobile-width-handwritten",
      "pattern": "(?<!(?:\\/\\/|\\n\\s*\\*)[^\\n]*)window\\.innerWidth\\s*(<|>=|<=|>)\\s*(767|768|769)",
      "files": "^src/.*\\.tsx?$",
      "sharedHome": "^src/hooks/useIsMobile\\.ts$|/__tests__/",
      "why": "画面幅 768 未満の判定は hooks/useIsMobile.ts だけが書く。Task 13 でフックへ寄せる(イベント内の一回判定は別途検討)"
    },
    {
      "id": "glass-tier-legacy",
      "pattern": "(?<!(?:\\/\\/|\\n\\s*\\*)[^\\n]*)glass-tier[23]\\b",
      "files": "^src/.*\\.tsx$",
      "sharedHome": "^src/styles/base/glass\\.css$|/__tests__/",
      "why": "古い浮かぶ面のクラス。浮かぶ面は float-surface に統一する。Task 13 で寄せて、最後に glass.css の定義を消す"
    }
  ],
  "frozen": {
    "outside-dismiss-handwritten": {},
    "menu-radius-handwritten": {
