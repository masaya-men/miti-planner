utton" class="housing-type-chip" data-selected="false" role="radio" aria-checked="false">アパルトメント</button></div></div><div class="housing-field housing-conditional-field" data-state="auto-filled"><label for="housing-register-plot" class="housing-label">番地</label><div class="housing-stepper"><input id="housing-register-plot" inputmode="numeric" class="housing-input housing-stepper-input" min="1" max="60" type="number" value="15"><span class="housing-stepper-btns" aria-hidden="true"><button type="button" class="housing-stepper-btn housing-stepper-up" data-testid="housing-register-plot-up" tabindex="-1">▲</button><button type="button" class="housing-stepper-btn housing-stepper-down" data-testid="housing-register-plot-down" tabindex="-1">▼</button></span></div><span class="housing-field-badge" data-testid="housing-auto-badge-plot" aria-hidden="true">🟡</span></div><div class="housing-field housing-conditional-field" data-state="auto-filled"><label for="housing-register-size" class="housing-label">サイズ</label><input id="housing-register-size" class="housing-input" disabled="" readonly="" type="text" value="Lハウス"><span class="housing-field-badge" data-testid="housing-auto-badge-size" aria-hidden="true">🟡</span></div><div class="housing-field housing-field-full housing-conditional-field" data-state="empty"><label class="housing-register-room-toggle"><input data-testid="housing-register-room-chamber-toggle" type="checkbox"><span class="housing-register-room-toggle-track" aria-hidden="true"><span class="housing-register-room-toggle-knob"></span></span><span>FCハウスの個室です</span></label></div></div></section></div><div data-step-id="intro"><section class="housing-register-section" data-testid="housing-register-section-intro"><h2 class="housing-register-section-title">コメント</h2><div class="housing-field"><label for="housing-register-title" class="housing-label">タイトル</label><input id="housing-register-title" data-testid="housing-register-title-input" class="housing-input" maxlength="50