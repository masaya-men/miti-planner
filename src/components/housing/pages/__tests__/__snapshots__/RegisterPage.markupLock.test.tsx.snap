ompass-needle-n" d="M20 8 L24.5 22 L20 19 L15.5 22 Z"></path><path class="housing-tour-map-compass-needle-s" d="M20 34 L15.5 22 L20 25 L24.5 22 Z"></path><text class="housing-tour-map-compass-n" x="20" y="7">N</text></svg></div><div class="housing-tour-map-hint" data-testid="tour-map-hint" aria-hidden="true">ホイールでズーム・ドラッグで移動</div></div></div></div><div class="housing-register-guide" data-testid="housing-register-guide"><h2 class="housing-register-guide-title">登録の流れ</h2><ol class="housing-register-guide-steps"><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">1</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">画像・SNS URL を貼る</span><span class="housing-register-guide-step-desc">Twitter / YouTube の URL を貼ると、 住所や画像を自動で読み取ります</span></div></li><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">2</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">住所・コメントを入力する</span><span class="housing-register-guide-step-desc">自動入力された内容を確認し、 タイトルやタグを添えます</span></div></li><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">3</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">公開設定を選んで登録する</span><span class="housing-register-guide-step-desc">公開または非公開を選び、 内容を確認して登録します</span></div></li></ol></div></div></section></div></div>",
  "label": "edit-saved",
}
`;

exports[`RegisterPage markupLock (分割前の記録) > edit 初期 → タイトル変更 → 保存(成功) / (失敗) 4`] = `
{
  "calls": [
    [
      "canRegister",
    ],
    [
      "update",
      "l1",
      {
        "afterExpiryVisibility": "unlisted",
        "allowPromoTweet": true,
        "area": "LavenderBeds",
        "buildingType": "house",
        "dc": "Meteor",
        "description": "テスト紹介文",
        "plot": 3,
        "publishUntil": null,
        "server": "Ramuh",
        "size": "L",
        "tags": [
          "official_cafe",
        ],
        "title": "テスト物件",
        "visibility": "public",
        "ward": 29,
      },
    ],
  ],
  "html": "<div></div><div><div class="housing-register" data-testid="housing-register-form-root"><section class="housing-register-panel" data-region="left"><div class="housing-register-col housing-register-col-left"><div class="housing-register-left-scroll"><nav class="housing-register-stepper" aria-label="登録ステップ"><div class="housing-register-stepper-viewport" data-overflow="false"><div class="housing-register-stepper-body" style="transform: translateY(0px);"><svg class="housing-register-stepper-svg" data-testid="housing-register-stepper-svg" width="100%" height="0" aria-hidden="true"><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><circle class="housing-register-step