  "html": "<div><div class="housing-register" data-testid="housing-register-form-root"><section class="housing-register-panel" data-region="left"><div class="housing-register-col housing-register-col-left"><div class="housing-register-left-scroll"><nav class="housing-register-stepper" aria-label="登録ステップ"><div class="housing-register-stepper-viewport" data-overflow="false"><div class="housing-register-stepper-body" style="transform: translateY(0px);"><svg class="housing-register-stepper-svg" data-testid="housing-register-stepper-svg" width="100%" height="0" aria-hidden="true"><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><line class="housing-register-stepper-connector-track" x1="21" y1="10" x2="21" y2="-10"></line><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><circle class="housing-register-stepper-ring-track" cx="21" cy="0" r="10"></circle><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><line class="housing-register-stepper-connector" x1="21" y1="10" x2="21" y2="-10" style="stroke-dasharray: -20; stroke-dashoffset: -20;"></line><circle class="housing-register-stepper-ring" c