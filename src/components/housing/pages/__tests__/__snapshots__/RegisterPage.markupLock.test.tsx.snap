16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">住所</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-2">自動入力でも手入力でも、登録前に必ず住所を確認します</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-3"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">3</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">コメント</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-3">タイトルは任意です。未入力の場合、一覧には住所が表示されます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-4"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">4</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">公開設定</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-4">公開・非公開と、公開期限を選べます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-5"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">5</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">確認</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-5">入力内容をまとめて確認し、登録します</span></span></span></span></button></li></ol></div></div></nav></div></div></section><section class="housing-register-panel" data-region="center"><div class="housing-register-col housing-register-col-center"><div class="housing-register-sections"><div data-step-id="media"><section class="housing-register-section" data-testid="housing-register-section-media"><h2 class="housing-register-section-title">SNS投稿・サイトから自動入力</h2><p class="housing-register-image-limit-note">画像は最大10枚まで、動画は最大1本まで登録できます。</p><div class="housing-register-multi-url-field"><div class="housing-register-multi-url-row"><div class="housing-register-sns-url-field"><label for="housing-sns-url" class="housing-label">投稿・サイトのURL（任意）</label><input id="housing-sns-url" class="housing-input" autocomplete="off" placeholder="URLを貼ってください" type="url" value=""><p class="housing-register-sns-url-help">X(旧Twitter)・YouTube・ハウジングスナップなどに対応。動画付きの投稿もOKです</p><p class="housing-register-sns-url-help housing-register-sns-url-help-disclaimer">自動入力は正確でない場合があります。あくまで入力の補助としてご利用ください。</p></div></div><button type="button" class="housing-register-multi-url-add" data-testid="housing-multi-url-add">＋ URLを追加</button></div><button type="button" data-testid="housing-register-toggle-upload" class="housing-register-toggle-upload">画像をアップロードして登録する</button></section></div><div data-step-id="address"><section class="housing-register-section" data-testid="housing-register-section-address"><h2 class="housing-register-section-title">住所</h2><p class="housing-address-note" data-testid="housing-register-address-verify-note">自動入力された住所も、登録前に必ず確認してください</p><div class="housing-register-fields-grid"><div class="housing-field" data-state="empty"><label for="housing-register-dc" class="housing-label">データセンター</label><select id="housing-register-dc" class="housing-input"><option value="">—</option><option value="Elemental">Elemental</option><option value="Gaia">Gaia</option><option value="Mana">Mana</option><option value="Meteor">Meteor</option><option value="Aether">Aether</option><option value="Primal">Primal</option><option value="Crystal">Crystal</option><option value="Dynamis">Dynamis</option><option value="Chaos">Chaos</option><option value="Light">Light</option><option value="Shadow">Shadow</option><option value="Materia">Materia</option><option value="Korea">韓国DC</option><option value="ChocoboCN">チョコボ (中国)</option><option value="MoogleCN">モーグリ (中国)</option><option value="FatCatCN">デブチョコボ (中国)</option><option value="MameshibaCN">マメシバ (中国)</option><option value="TW">TW</option></select></div><div class="housing-field" data-state="empty"><label for="housing-register-server" class="housing-label">サーバー</label><select id="housing-register-server" class="housing-input" disabled=""><option value="">—</option></select></div><div class="housing-field" data-state="empty"><label for="housing-register-area" class="housing-label">エリア</label><select id="housing-register-area" class="housing-input"><option value="">—</option><option value="Mist">ミスト・ヴィレッジ</option><option value="LavenderBeds">ラベンダーベッド</option><option value="Goblet">ゴブレットビュート</option><option value="Shirogane">シロガネ</option><option value="Empyreum">エンピレアム</option></select></div><div class="housing-field" data-state="empty"><label for="housing-register-ward" class="housing-label">区</label><div class="housing-stepper"><input id="housing-register-ward" inputmode="numeric" class="housing-input housing-stepper-input" min="1" max="30" type="number" value=""><span class="housing-stepper-btns" aria-hidden="true"><button type="button" class="housing-stepper-btn housing-stepper-up" data-testid="housing-register-ward-up" tabindex="-1">▲</button><button type="button" class="housing-stepper-btn housing-stepper-down" data-testid="housing-register-ward-down" tabindex="-1">▼</button></span></div></div><div class="housing-field housing-field-full" data-state="empty"><label class="housing-label">建物タイプ</label><div class="housing-type-selector" role="radiogroup"><button type="button" class="housing-type-chip" data-selected="false" role="radio" aria-checked="false">個人宅・FCハウス</button><button type="button" class="housing-type-chip" data-selected="false" role="radio" aria-checked="false">アパルトメント</button></div></div></div></section></div><div data-step-id="intro"><section class="housing-register-section" data-testid="housing-register-section-intro"><h2 class="housing-register-section-title">コメント</h2><div class="housing-field"><label for="housing-register-title" class="housing-label">タイトル</label><input id="housing-register-title" data-testid="housing-register-title-input" class="housing-input" maxlength="50" placeholder="タイトルを入力" type="text" value=""><p class="housing-address-note" data-testid="housing-register-title-remaining">残り 50 文字</p><p class="housing-address-note" data-testid="housing-register-title-optional-hint">未入力の場合、住所が表示されます</p></div><div class="housing-field"><label for="housing-desc" class="housing-label">コメント (任意・200文字まで)</label