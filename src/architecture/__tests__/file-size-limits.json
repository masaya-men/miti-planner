    "src/components/admin/wizard/ContentWizard.tsx": 666,
    "src/components/admin/wizard/StatsWizard.tsx": 946,
    "src/components/admin/wizard/TemplateWizard.tsx": 609,
    "src/components/EventForm.tsx": 981,
    "src/components/FFLogsImportModal.tsx": 551,
    "src/components/housing/browse/__tests__/ListingCard.test.tsx": 647,
    "src/components/housing/pages/__tests__/RegisterPage.test.tsx": 2132,
    "src/components/housing/pages/__tests__/TourNavPage.test.tsx": 506,
    "src/components/housing/tour/TourNavMap.tsx": 564,
    "src/components/LocalImportDialog.tsx": 616,
