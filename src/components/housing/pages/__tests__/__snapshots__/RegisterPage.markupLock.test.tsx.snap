h="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">住所</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-2">自動入力でも手入力でも、登録前に必ず住所を確認します</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-3"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">3</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">コメント</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-3">タイトルは任意です。未入力の場合、一覧には住所が表示されます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-4"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">4</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">公開設定</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-4">公開・非公開と、公開期限を選べます</span></span></span></span></button></li><li><button type="button" class="housing-register-stepper-item is-idle" data-testid="housing-register-step-5"><span class="housing-register-stepper-num" aria-hidden="true"><span class="housing-register-stepper-num-digit">5</span><svg class="housing-register-stepper-check" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="housing-register-stepper-content"><span class="housing-register-stepper-label">確認</span><span class="housing-register-stepper-desc-wrap"><span class="housing-register-stepper-desc-inner"><span class="housing-register-stepper-desc" data-testid="housing-register-step-desc-5">入力内容をまとめて確認し、登録します</span></span></span></span></button></li></ol></div></div></nav></div><p class="housing-register-left-remaining" data-testid="housing-register-guide-remaining">登録チケット：管理者</p></div></section><section class="housing-register-panel" data-region="center"><div class="housing-register-col housing-register-col-center"><div class="housing-register-sections"><div data-step-id="media"><section class="housing-register-section" data-testid="housing-register-section-media"><h2 class="housing-register-section-title">SNS投稿・サイトから自動入力</h2><p class="housing-register-image-limit-note">画像は最大10枚まで、動画は最大1本まで登録できます。</p><div class="housing-register-multi-url-field"><div class="housing-register-multi-url-row"><div class="housing-register-sns-url-field"><label for="housing-sns-url" class="housing-label">投稿・サイトのURL（任意）</label><input id="housing-sns-url" class="housing-input" autocomplete="off" placeholder="URLを貼ってください" type="url" value=""><p class="housing-register-sns-url-help">X(旧Twitter)・YouTube・ハウジングスナップなどに対応。動画付きの投稿もOKです</p><p class="housing-register-sns-url-help housing-register-sns-url-help-disclaimer">自動入力は正確でない場合があります。あくまで入力の補助としてご利用ください。</p></div></div><button type="button" class="housing-register-multi-url-add" data-testid="housing-multi-url-add">＋ URLを追加</button></div><button type="button" data-testid="housing-register-toggle-upload" class="housing-register-toggle-upload">画像をアップロードして登録する</button></section></div><div data-step-id="address"><section class="housing-register-section" data-testid="housing-register-section-address"><h2 class="housing-register-section-title">住所</h2><p class="housing-address-note" data-testid="housing-register-address-verify-note">自動入力された住所も、登録前に必ず確認してください</p><div class="housing-register-fields-grid"><div class="housing-field" data-state="empty"><label for="housing-register-dc" class="housing-label">データセンター</label><select id="housing-register-dc" class="housing-input"><option value="">—</option><option value="Elemental">Elemental</option><option value="Gaia">Gaia</option><option value="Mana">Mana</option><option value="Meteor">Meteor</option><option value="Aether">Aether</option><option value="Primal">Primal</option><option value="Crystal">Crystal</option><option value="Dynamis">Dynamis</option><option value="Chaos">Chaos</option><option value="Light">Light</option><option value="Shadow">Shadow</option><option value="Materia">Materia</option><option value="Korea">韓国DC</option><option value="ChocoboCN">チョコボ (中国)</option><option value="MoogleCN">モーグリ (中国)</option><option value="FatCatCN">デブチョコボ (中国)</option><option value="MameshibaCN">マメシバ (中国)</option><option value="TW">TW</option></select></div><div class="housing-field" data-state="empty"><label for="housing-register-server" class="housing-label">サーバー</label><select id="housing-register-server" class="housing-input" disabled=""><option value="">—</option></select></div><div class="housing-field" data-state="empty"><label for="housing-register-area" class="housing-label">エリア</label><select id="housing-register-area" class="housing-input"><option value="">—</option><option value="Mist">ミスト・ヴィレッジ</option><option value="LavenderBeds">ラベンダーベッド</option><option value="Goblet">ゴブレットビュート</option><option value="Shirogane">シロガネ</option><option value="Empyreum">エンピレアム</option></select></div><div class="housing-field" data-state="empty"><label for="housing-register-ward" class="housing-label">区</label><div class="housing-stepper"><input id="housing-register-ward" inputmode="numeric" class="housing-input housing-stepper-input" min="1" max="30" type="number" value=""><span class="housing-stepper-btns" aria-hidden="true"><button type="button" class="housing-stepper-btn housing-stepper-up" data-testid="housing-register-ward-up" tabindex="-1">▲</button><button type="button" class="housing-stepper-btn housing-stepper-down" data-testid="housing-register-ward-down" tabindex="-1">▼</button></span></div></div><div class="housing-field housing-field-full" data-state="empty"><label class="housing-label">建物タイプ</label><div class="housing-type-selector" role="radiogroup"><button type="button" class="housing-type-chip" data-selected="false" role="radio" aria-checked="false">個人宅・FCハウス</button><button type="button" class="housing-type-chip" data-selected="false" role="radio" aria-checked="false">アパルトメント</button></div></div></div></section></div><div data-step-id="intro"><section class="housing-register-section" data-testid="housing-register-section-intro"><h2 class="housing-register-section-title">コメント</h2><div class="housing-field"><label for="housing-register-title" class="housing-label">タイトル</label><input id="housing-register-title" data-testid="housing-register-title-input" class="housing-input" maxlength="50" placeholder="タイトルを入力" type="text" value=""><p class="housing-address-note" data-testid="housing-register-title-remaining">残り 50 文字</p><p class="housing-address-note" data-testid="housing-register-title-optional-hint">未入力の場合、住所が表示されます</p></div><div class="housing-field"><label for="housing-desc" class="housing-label">コメント (任意・200文字まで)</label><textarea id="housing-desc" rows="4" maxlength="250" class="housing-textarea" placeholder="自由に書いてください"></textarea><p class="housing-address-note">200</p></div><div class="housing-tag-picker"><div class="housing-tag-picker-selected" aria-label="選択中"><span class="housing-tag-picker-counter">テーマを 5 件まで選べます</span></div><input placeholder="タグを検索…" class="housing-input housing-tag-picker-search" type="search" value=""><div class="housing-tag-picker-tabs" role="tablist"><button role="tab" type="button" aria-selected="true" class="housing-tag-picker-tab">公式</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">季節</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">テーマ</button><button role="tab" type="button" aria-selected="false" class="housing-tag-picker-tab">初心者</button></div><div class="housing-tag-picker-list"><button type="button" aria-pressed="false" class="housing-tag-picker-option">ショップ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">マネキンショップ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">こだわりの内装</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">交流帳</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">酒場</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">レストラン</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">訪問歓迎</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">内装準備中</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">ロールプレイ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">水族館</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">聖堂</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">喫茶店</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">花屋</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">図書館</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">アトリエ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">銭湯</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">植物園</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">パン屋</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">音楽堂</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">イベント</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">撮影スタジオ</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">ホラーハウス</button><button type="button" aria-pressed="false" class="housing-tag-picker-option">東方様式</button></div></div></section></div><div data-step-id="visibility"><section class="housing-register-section" data-testid="housing-register-section-visibility"><h2 class="housing-register-section-title">公開設定</h2><div class="housing-field housing-field-full"><div class="housing-type-selector" role="radiogroup" aria-label="公開範囲"><button type="button" class="housing-register-visibility-chip" data-testid="housing-register-visibility-public" data-selected="true" role="radio" aria-checked="true"><span class="housing-register-visibility-chip-title">公開</span><span class="housing-register-visibility-chip-desc">探す・地図・ツアーに表示され、住所も見えます</span></button><button type="button" class="housing-register-visibility-chip" data-testid="housing-register-visibility-unlisted" data-selected="false" role="radio" aria-checked="false"><span class="housing-register-visibility-chip-title">住所非公開</span><span class="housing-register-visibility-chip-desc">画像は探すに出ますが、住所は隠れ、ツアーには使えません</span></button><button type="button" class="housing-register-visibility-chip" data-testid="housing-register-visibility-private" data-selected="false" role="radio" aria-checked="false"><span class="housing-register-visibility-chip-title">非公開</span><span class="housing-register-visibility-chip-desc">自分だけが見られます</span></button></div></div><div class="housing-register-promo" data-testid="housing-register-promo"><label class="housing-register-promo-toggle"><input data-testid="housing-register-promo-toggle" type="checkbox" checked=""><span class="housing-register-promo-toggle-track" aria-hidden="true"><span class="housing-register-promo-toggle-knob"></span></span><span>LoPo 運営による X（Twitter）での紹介を許可する</span></label><p class="housing-register-promo-note">オンのとき、登録後に LoPo 運営が X でこのハウジングを紹介することがあります。オフにしても公開範囲や表示は変わりません。</p></div><div class="housing-register-visibility-enddate"><label class="housing-register-visibility-enddate-toggle"><input data-testid="housing-register-visibility-enddate-toggle" type="checkbox"><span class="housing-register-visibility-enddate-toggle-track" aria-hidden="true"><span class="housing-register-visibility-enddate-toggle-knob"></span></span><span>公開終了日時を設定する</span></label></div><p class="housing-register-visibility-note">公開終了日時を過ぎると、 選んだ設定に自動的に切り替わります</p></section></div><div data-step-id="confirm"><section class="housing-register-section" data-testid="housing-register-section-confirm"><h2 class="housing-register-section-title">確認</h2><div class="housing-register-confirm-address" data-testid="housing-register-confirm-address-gate"><div class="housing-register-confirm-address-line"><span class="housing-register-confirm-address-label">住所</span><span class="housing-register-confirm-address-value"><span class="housing-register-confirm-summary-empty">未入力</span></span></div><p class="housing-register-confirm-gate-lead">住所を確認して、下のボタンを押してください</p><button type="button" class="housing-register-confirm-gate-btn" data-testid="housing-register-confirm-address-btn" data-confirmed="false" data-address-missing="true" disabled="">先に住所を入力してください</button></div><dl class="housing-register-confirm-summary"><div class="housing-register-confirm-summary-row"><dt>タイトル</dt><dd><span class="housing-register-confirm-summary-empty">未入力</span></dd></div><div class="housing-register-confirm-summary-row"><dt>SNS投稿・サイトから自動入力</dt><dd>0 枚</dd></div><div class="housing-register-confirm-summary-row"><dt>公開設定</dt><dd>公開</dd></div></dl><div class="housing-register-confirm-missing"><p class="housing-register-confirm-missing-lead">登録するには、 以下を入力してください</p><ul class="housing-register-confirm-missing-list"><li data-testid="housing-register-confirm-missing-address">住所を入力してください</li><li data-testid="housing-register-confirm-missing-image">画像または動画を追加してください</li></ul></div><button type="button" class="housing-action-btn housing-btn-primary housing-register-confirm-submit" data-testid="housing-register-confirm-submit" disabled="">公開する</button></section></div></div></div></section><section class="housing-register-panel" data-region="right"><div class="housing-register-col housing-register-col-right"><div class="housing-register-check-panel" data-testid="housing-register-check-panel"><h2 class="housing-register-check-panel-title">登録前に確認</h2><ul class="housing-register-check-list"><li class="housing-register-check-row is-todo" data-testid="housing-register-check-address"><span class="housing-register-check-icon" aria-hidden="true">⚠</span><span class="housing-register-check-label">住所</span></li><li class="housing-register-check-row is-todo" data-testid="housing-register-check-title"><span class="housing-register-check-icon" aria-hidden="true">⚠</span><span class="housing-register-check-label">タイトル (任意)</span></li><li class="housing-register-check-row is-todo" data-testid="housing-register-check-image"><span class="housing-register-check-icon" aria-hidden="true">⚠</span><span class="housing-register-check-label">画像・動画 (必須)</span></li></ul></div><div class="housing-register-dup-panel" data-state="idle" data-testid="housing-register-dup-panel"><h2 class="housing-register-dup-panel-title">重複チェック</h2><p class="housing-register-dup-quiet-text" data-testid="housing-register-dup-idle">住所を入力すると、 同じ住所の既存ハウジングを確認します</p></div><div class="housing-register-guide" data-testid="housing-register-guide"><h2 class="housing-register-guide-title">登録の流れ</h2><ol class="housing-register-guide-steps"><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">1</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">画像・SNS URL を貼る</span><span class="housing-register-guide-step-desc">Twitter / YouTube の URL を貼ると、 住所や画像を自動で読み取ります</span></div></li><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">2</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">住所・コメントを入力する</span><span class="housing-register-guide-step-desc">自動入力された内容を確認し、 タイトルやタグを添えます</span></div></li><li class="housing-register-guide-step"><span class="housing-register-guide-num" aria-hidden="true">3</span><div class="housing-register-guide-body"><span class="housing-register-guide-step-title">公開設定を選んで登録する</span><span class="housing-register-guide-step-desc">公開または非公開を選び、 内容を確認して登録します</span></div></li></ol></div></div></section></div></div>",
  "label": "create-admin",
}
`;

